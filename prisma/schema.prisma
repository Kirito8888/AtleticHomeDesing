// =============================================================================
// LifeOS — schema.prisma
// PostgreSQL 17 + pgvector. Multiusuario (ATHLETE / COACH / ADMIN).
// Convenciones:
//   - ids cuid(), timestamps createdAt/updatedAt.
//   - Fechas "de día" (sin hora) como @db.Date.
//   - Importes monetarios en céntimos de EUR (Int). Nunca Float para dinero.
//   - Distancias en metros, tiempos en segundos, pesos de carga en kg,
//     pesos de implementos en gramos.
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// =============================================================================
// 1. IDENTIDAD, AUTH (Auth.js v5 Prisma Adapter) Y RELACIÓN COACH → ATLETA
// =============================================================================

enum UserRole {
  ATHLETE
  COACH
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String? // solo para login con credenciales
  role           UserRole  @default(ATHLETE)
  timezone       String    @default("Europe/Madrid")
  // Seguridad (v1.1): bloqueo tras intentos fallidos y revocación de sesiones JWT
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  sessionVersion Int       @default(1)
  // Privacidad (v1.1): fecha en que el usuario autorizó enviar datos a Gemini (null = no)
  aiConsentAt    DateTime?
  // Seguridad (v1.2): 2FA TOTP. Secreto cifrado (AES-256-GCM, TOTP_ENCRYPTION_KEY);
  // totpEnabledAt null = pendiente de confirmar o desactivado. totpLastStep evita reutilizar un código.
  totpSecret     String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  coaching  CoachAthlete[] @relation("CoachLinks")
  coachedBy CoachAthlete[] @relation("AthleteLinks")

  athleteProfile    AthleteProfile?
  thresholds        ThresholdHistory[]
  trainingSessions  TrainingSession[]
  plannedSessions   TrainingSession[]      @relation("PlannedBy")
  personalRecords   PersonalRecord[]
  dailyLoads        DailyLoad[]
  recoveryMetrics   RecoveryMetrics[]
  customExercises   Exercise[]
  trainingCycles    TrainingCycle[]
  calendarEvents    CalendarEvent[]
  tasks             Task[]
  financialAccounts FinancialAccount[]
  financialCats     FinancialCategory[]
  transactions      FinancialTransaction[]
  budgets           Budget[]
  subscriptions     Subscription[]
  macros            Macros[]
  nutritionGoals    NutritionGoal[]
  studyDocuments    StudyDocument[]
  chatThreads       ChatThread[]
  flashcardDecks    FlashcardDeck[]
  coachReports      CoachReport[]
  recoveryCodes     RecoveryCode[]
  securityEvents    SecurityEvent[]
  sessionTemplates  SessionTemplate[]
  mealTemplates     MealTemplate[]
  injuries          Injury[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  bankProfiles      BankImportProfile[]
  planMesos         PlanMeso[]
  planDays          PlanDay[]
  planFeedback      PlanFeedback[]
  cycleProfile      CycleProfile?
  cycleLogs         CycleLog[]
  oneRepMaxes       OneRepMax[]
  exerciseAliases   ExerciseAlias[]
  calendarFeeds     CalendarFeed[]
  sharedReports     SharedReport[]
  womenHealth       WomenHealth?
  healthLogs        HealthLog[]
  testResults       TestResult[]
  returnProtocols   ReturnProtocol[]
  classSlots        ClassSlot[]
  studySessions     StudySession[]
  habits            Habit[]
  habitLogs         HabitLog[]
  equipment         Equipment[]
  hydrationLogs     HydrationLog[]
  sessionComments   SessionComment[]       @relation("CommentAthlete")
  authoredComments  SessionComment[]       @relation("CommentAuthor")
}

/// Códigos de recuperación de 2FA (un solo uso). Solo se guarda su hash.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  EMAIL_CHANGED
  SESSIONS_REVOKED
  TOTP_ENABLED
  TOTP_DISABLED
  RECOVERY_CODE_USED
  DATA_EXPORTED
  AI_CONSENT_CHANGED
  COACH_SCOPES_CHANGED
}

/// Registro de auditoría visible por el usuario (Ajustes → Actividad). Se borra con la cuenta
/// y a los 180 días (src/lib/scheduler.ts).
model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  type      SecurityEventType
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Qué datos deportivos del atleta ve el coach (v1.2). Por defecto, todos.
enum CoachScope {
  LOAD // PMC, carga diaria, marcas
  SESSIONS // sesiones de entrenamiento
  RECOVERY // recuperación, readiness y lesiones
  PLANNING // ciclos y calendario
  REPORTS // informes del coach IA
}

enum CoachLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// Un coach puede leer (y opcionalmente planificar) los datos deportivos del atleta.
/// Finanzas / estudio NUNCA se comparten por esta relación.
model CoachAthlete {
  id         String          @id @default(cuid())
  coachId    String
  athleteId  String
  status     CoachLinkStatus @default(PENDING)
  canPlan    Boolean         @default(false) // puede crear sesiones planificadas/ciclos
  scopes     CoachScope[]    @default([LOAD, SESSIONS, RECOVERY, PLANNING, REPORTS])
  createdAt  DateTime        @default(now())
  acceptedAt DateTime?

  coach   User @relation("CoachLinks", fields: [coachId], references: [id], onDelete: Cascade)
  athlete User @relation("AthleteLinks", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

// =============================================================================
// 2. PERFIL DEL ATLETA Y UMBRALES (versionados para no reescribir el TSS histórico)
// =============================================================================

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum Discipline {
  SPRINT
  MIDDLE_DISTANCE
  LONG_DISTANCE
  HURDLES
  JUMPS
  THROWS
  COMBINED_EVENTS
  SWIMMING
  CYCLING
  STRENGTH
  OTHER
}

model AthleteProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  birthDate         DateTime?    @db.Date
  sex               Sex?
  heightCm          Float?
  bodyWeightKg      Float?
  primaryDiscipline Discipline?
  disciplines       Discipline[]
  // Constantes del modelo de Banister (configurables por atleta)
  ctlTimeConstant   Int          @default(42)
  atlTimeConstant   Int          @default(7)
  // «Mis reglas» (umbrales de avisos, redondeo de kg, recordatorios…). Valores por defecto en src/lib/rules/prefs.ts.
  prefs             Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Umbrales fisiológicos con fecha de vigencia. El cálculo de TSS de una sesión
/// usa el registro con mayor effectiveFrom <= fecha de la sesión.
model ThresholdHistory {
  id                          String   @id @default(cuid())
  userId                      String
  effectiveFrom               DateTime @db.Date
  hrMax                       Int?
  hrRest                      Int?
  lthr                        Int? // FC en umbral láctico (base de hrTSS)
  thresholdPaceSecPerKm       Float? // ritmo umbral carrera (rTSS)
  thresholdPaceSecPer100mSwim Float? // CSS natación (sTSS natación)
  ftpWatts                    Int?
  notes                       String?
  createdAt                   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
}

// =============================================================================
// 3. ENTRENAMIENTO MULTI-DISCIPLINA
//    TrainingSession = cabecera común (alimenta CTL/ATL/TSB con una sola serie).
//    TrackSession / TechnicalSession / StrengthSession = detalle 1:1 por tipo.
// =============================================================================

enum SessionType {
  TRACK // pista / cardio: fondo, velocidad, natación, ciclismo
  TECHNICAL // lanzamientos y saltos
  STRENGTH // gimnasio
  MIXED // sesión con varias partes (p.ej. técnica + fuerza)
}

enum SessionStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum TssMethod {
  HR_TSS // basado en FC y LTHR (Coggan/Friel)
  PACE_TSS // rTSS / swim TSS basado en ritmo umbral
  SRPE // Foster: RPE de sesión x minutos, normalizado
  TONNAGE // carga de fuerza: tonelaje relativo + intensidad (RPE/RIR)
  TECHNICAL // nº de intentos x intensidad del implemento x RPE
  MANUAL
}

model TrainingSession {
  id            String        @id @default(cuid())
  userId        String
  plannedById   String? // coach que la planificó (null = el propio atleta)
  cycleId       String? // microciclo al que pertenece
  date          DateTime      @db.Date
  startedAt     DateTime?
  type          SessionType
  discipline    Discipline?
  status        SessionStatus @default(COMPLETED)
  title         String?
  durationSec   Int? // duración total de la sesión
  sessionRpe    Float? // 1-10 (CR-10 de Foster)
  // Carga calculada por el motor de fatiga (Fase 2). Persistida para series rápidas.
  tss           Float?
  tssMethod     TssMethod?
  tssComputedAt DateTime?
  notes         String?
  // Sensaciones al cerrar la sesión: [{ area, side?, pain 0-10 }] (alimentan los avisos)
  feelings      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedBy User?          @relation("PlannedBy", fields: [plannedById], references: [id], onDelete: SetNull)
  cycle     TrainingCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  track           TrackSession?
  technical       TechnicalSession?
  strength        StrengthSession?
  personalRecords PersonalRecord[]

  @@index([userId, date])
  @@index([cycleId])
}

// ---------- 3.1 Pista / Cardio ----------

enum TrackModality {
  RUN
  SPRINT
  HURDLES
  SWIM
  CYCLE
  ROW
  WALK
  OTHER
}

enum TrackSurface {
  TRACK
  ROAD
  TRAIL
  TREADMILL
  POOL_25
  POOL_50
  OPEN_WATER
  OTHER
}

model TrackSession {
  id                String        @id @default(cuid())
  sessionId         String        @unique
  modality          TrackModality
  surface           TrackSurface?
  distanceM         Float?
  movingTimeSec     Int?
  avgPaceSecPerKm   Float? // derivado; para natación usar avgPaceSecPer100m
  avgPaceSecPer100m Float?
  hrAvg             Int?
  hrMax             Int?
  elevationGainM    Float?
  avgCadence        Int?
  temperatureC      Float?
  // Tiempo en zonas de FC en segundos [Z1..Z5] — permite TRIMP/hrTSS más fino
  hrZoneSeconds     Int[]

  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  intervals TrackInterval[]
}

/// Series / repeticiones (p.ej. 6x300m rec 3') con splits opcionales.
model TrackInterval {
  id             String  @id @default(cuid())
  trackSessionId String
  order          Int
  repetition     Int     @default(1) // nº de la repetición dentro del bloque
  distanceM      Float?
  timeSec        Float? // Float: los sprints se miden en centésimas
  recoverySec    Int?
  hrAvg          Int?
  hrMax          Int?
  rpe            Float?
  isStartBlocks  Boolean @default(false) // salida de tacos
  isFlying       Boolean @default(false) // lanzado
  splitsSec      Float[] // parciales (p.ej. cada 100m)
  notes          String?

  trackSession TrackSession @relation(fields: [trackSessionId], references: [id], onDelete: Cascade)

  @@unique([trackSessionId, order])
}

// ---------- 3.2 Técnica: lanzamientos y saltos ----------

enum TechnicalEvent {
  JAVELIN
  SHOT_PUT
  DISCUS
  HAMMER
  WEIGHT_THROW
  LONG_JUMP
  TRIPLE_JUMP
  HIGH_JUMP
  POLE_VAULT
  OTHER
}

enum ApproachType {
  STANDING // parado
  SHORT // carrera corta
  MEDIUM
  FULL // carrera completa
  GLIDE // desplazamiento (peso)
  ROTATIONAL // giro (peso/disco/martillo)
}

model TechnicalSession {
  id               String         @id @default(cuid())
  sessionId        String         @unique
  event            TechnicalEvent
  implementWeightG Int? // 800 (jabalina sénior M), 600, 7260 (peso), etc.
  implementModel   String? // marca/modelo de la jabalina o pértiga
  poleLengthCm     Int?
  poleFlex         Float?
  approachType     ApproachType?
  approachSteps    Int? // nº de apoyos/zancadas de carrera
  windMs           Float? // viento general de la sesión
  isCompetition    Boolean        @default(false)
  focus            String? // objetivo técnico de la sesión
  bestMarkM        Float? // desnormalizado del mejor intento válido
  // Vídeo contado: de N lanzamientos revisados, cuántos con el codo estirado y con la cabeza estable
  videoTotal       Int?
  videoElbowOk     Int?
  videoHeadOk      Int?
  // Condiciones a la hora de la sesión (Open-Meteo): { tempC, windMs, windDirDeg, rainMm, at }
  conditions       Json?

  session  TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts TechnicalAttempt[]
}

model TechnicalAttempt {
  id                 String   @id @default(cuid())
  technicalSessionId String
  order              Int
  markM              Float? // null si nulo / no medido
  isFoul             Boolean  @default(false)
  isMeasured         Boolean  @default(true)
  windMs             Float?
  barHeightM         Float? // altura / pértiga
  cleared            Boolean? // altura / pértiga
  approachSteps      Int?
  rating             Int? // 1-5 autovaloración
  // Notas técnicas por fase
  runUpNotes         String? // fase de carrera / ritmo de los últimos apoyos
  blockNotes         String? // bloqueo / batida
  releaseNotes       String? // suelta / ángulo / vuelo
  videoUrl           String?
  createdAt          DateTime @default(now())

  technicalSession TechnicalSession @relation(fields: [technicalSessionId], references: [id], onDelete: Cascade)

  @@unique([technicalSessionId, order])
}

// ---------- 3.3 Fuerza (gimnasio) ----------

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  FULL_BODY
}

enum MovementPattern {
  SQUAT
  HINGE
  LUNGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  CARRY
  ROTATION
  OLYMPIC_LIFT
  PLYOMETRIC
  ISOLATION
}

enum LoadType {
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  BODYWEIGHT
  MEDBALL
  BAND
  OTHER
}

/// Catálogo de ejercicios. userId null = ejercicio global del sistema.
model Exercise {
  id               String           @id @default(cuid())
  userId           String?
  name             String
  primaryMuscle    MuscleGroup?
  secondaryMuscles MuscleGroup[]
  pattern          MovementPattern?
  loadType         LoadType         @default(BARBELL)
  isUnilateral     Boolean          @default(false)
  // Si el peso corporal cuenta en el tonelaje (dominadas, fondos...)
  bodyweightFactor Float            @default(0)
  createdAt        DateTime         @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets            StrengthSet[]
  personalRecords PersonalRecord[]

  @@unique([userId, name])
}

model StrengthSession {
  id           String @id @default(cuid())
  sessionId    String @unique
  tonnageKg    Float? // Σ reps x peso de series efectivas (calculado en Fase 2)
  bodyWeightKg Float? // peso corporal del día, para ejercicios con peso corporal

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets    StrengthSet[]
}

model StrengthSet {
  id                String   @id @default(cuid())
  strengthSessionId String
  exerciseId        String
  order             Int // orden global en la sesión
  setIndex          Int // nº de serie dentro del ejercicio
  reps              Int
  weightKg          Float    @default(0)
  rpe               Float? // 6-10 (escala RPE de Tuchscherer)
  rir               Int? // repeticiones en reserva
  isWarmup          Boolean  @default(false)
  isFailure         Boolean  @default(false)
  tempo             String? // "3-1-X-0"
  restSec           Int?
  velocityMs        Float? // velocidad media propulsiva (VBT), si se mide
  est1RmKg          Float? // Epley/Brzycki ajustado por RIR (Fase 2)
  notes             String?
  createdAt         DateTime @default(now())

  strengthSession StrengthSession @relation(fields: [strengthSessionId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([strengthSessionId, order])
  @@index([exerciseId])
}

// ---------- 3.4 Marcas personales ----------

enum RecordKind {
  TECHNICAL_MARK // marca en lanzamiento/salto (m)
  TRACK_TIME // tiempo en distancia (s)
  ONE_RM // 1RM real o estimado (kg)
}

model PersonalRecord {
  id               String          @id @default(cuid())
  userId           String
  kind             RecordKind
  technicalEvent   TechnicalEvent?
  implementWeightG Int?
  trackDistanceM   Float?
  exerciseId       String?
  value            Float // metros, segundos o kg según kind
  isEstimated      Boolean         @default(false)
  isCompetition    Boolean         @default(false)
  achievedOn       DateTime        @db.Date
  sessionId        String?
  createdAt        DateTime        @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  session  TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, kind, achievedOn])
}

// ---------- 3.5 Carga diaria (PMC) ----------

/// Serie diaria materializada. Recalculable en cualquier momento desde
/// TrainingSession.tss (no es fuente de verdad).
model DailyLoad {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  tss       Float    @default(0) // Σ TSS del día
  ctl       Float // Fitness  (EWMA 42 d)
  atl       Float // Fatiga   (EWMA 7 d)
  tsb       Float // Forma    (CTL_ayer - ATL_ayer)
  acwr      Float? // ratio carga aguda:crónica
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// =============================================================================
// 4. RECUPERACIÓN
// =============================================================================

model RecoveryMetrics {
  id             String        @id @default(cuid())
  userId         String
  date           DateTime      @db.Date
  sleepHours     Float?
  sleepQuality   Int? // 1-5
  hrvRmssdMs     Float? // VFC (rMSSD, ms) medida al despertar
  restingHr      Int? // FC en reposo
  doms           Int? // 0-10 dolor muscular de aparición tardía
  domsAreas      MuscleGroup[]
  fatigue        Int? // 1-5 (wellness Hooper)
  stress         Int? // 1-5
  mood           Int? // 1-5
  bodyWeightKg   Float?
  bodyFatPct     Float? // % de grasa de la báscula (solo como tendencia)
  // Control rápido (p. ej. el del lunes): dolor 0-10 en el test squeeze y en el talón, salto en cm
  squeezePain    Int?
  heelPain       Int?
  jumpCm         Float?
  elbowSymptoms  Boolean? // hormigueo o dolor en el codo al lanzar
  // Resultado del algoritmo de Readiness (Fase 2) + desglose para auditar
  readinessScore Float? // 0-100
  readinessParts Json? // { tsb, hrv, sleep, rhr, doms }
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// =============================================================================
// 5. PERIODIZACIÓN Y PRODUCTIVIDAD
// =============================================================================

enum CycleLevel {
  MACRO
  MESO
  MICRO
}

enum CyclePhase {
  GENERAL_PREP
  SPECIFIC_PREP
  PRE_COMPETITION
  COMPETITION
  TAPER
  DELOAD
  TRANSITION
}

model TrainingCycle {
  id          String      @id @default(cuid())
  userId      String
  parentId    String?
  level       CycleLevel
  phase       CyclePhase?
  name        String
  goal        String?
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  plannedLoad Float? // TSS objetivo del ciclo (útil en microciclos)
  color       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   TrainingCycle?    @relation("CycleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TrainingCycle[]   @relation("CycleTree")
  sessions TrainingSession[]
  events   CalendarEvent[]

  @@index([userId, startDate])
}

enum CalendarEventType {
  COMPETITION
  TEST_1RM
  TIME_TRIAL // toma de marca / test de pista
  TAPER
  DELOAD
  STUDY_BLOCK
  EXAM
  OTHER
}

enum CompetitionPriority {
  A
  B
  C
}

model CalendarEvent {
  id          String               @id @default(cuid())
  userId      String
  cycleId     String?
  type        CalendarEventType
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean              @default(true)
  priority    CompetitionPriority? // solo competiciones
  location    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle TrainingCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  tags        String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
}

// =============================================================================
// 6. FINANZAS — PARTIDA DOBLE (solo EUR, céntimos)
//    Invariante: Σ Posting.amountCents de una transacción = 0.
//    Convención de signo: + = débito, − = crédito.
//      Gasto 12,50 € con tarjeta: EXPENSE:+1250 / ASSET(banco):−1250
//      Nómina 1500 €:             ASSET(banco):+150000 / INCOME:−150000
//      Transferencia:             ASSET(ahorro):+X / ASSET(corriente):−X
// =============================================================================

enum FinancialAccountType {
  ASSET // cuentas bancarias, efectivo, inversiones
  LIABILITY // tarjetas de crédito, préstamos
  INCOME
  EXPENSE
  EQUITY // saldo de apertura
}

model FinancialAccount {
  id          String               @id @default(cuid())
  userId      String
  name        String
  type        FinancialAccountType
  currency    String               @default("EUR") @db.Char(3)
  institution String?
  isArchived  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postings      Posting[]
  subscriptions Subscription[]

  @@unique([userId, name])
}

model FinancialCategory {
  id       String               @id @default(cuid())
  userId   String
  parentId String?
  name     String
  kind     FinancialAccountType // INCOME o EXPENSE
  color    String?
  icon     String?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      FinancialCategory[] @relation("CategoryTree")
  postings      Posting[]
  budgets       Budget[]
  subscriptions Subscription[]

  @@unique([userId, name])
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
}

model FinancialTransaction {
  id             String          @id @default(cuid())
  userId         String
  date           DateTime        @db.Date
  kind           TransactionKind
  description    String
  payee          String?
  subscriptionId String? // si la generó una suscripción recurrente
  // Huella del movimiento importado de un extracto (fecha|importe|concepto|n.º de orden):
  // reimportar el mismo extracto no duplica movimientos.
  importHash     String?
  reconciled     Boolean         @default(false)
  // Gasto deportivo (material, viajes de competición, licencias) y competición asociada
  sport          Boolean         @default(false)
  eventId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  postings     Posting[]

  @@unique([userId, importHash])
  @@index([userId, date])
}

model Posting {
  id            String  @id @default(cuid())
  transactionId String
  accountId     String
  categoryId    String? // para informes de gasto/ingreso por categoría
  amountCents   Int // con signo: + débito / − crédito
  memo          String?

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    FinancialCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([categoryId])
  @@index([transactionId])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Budget {
  id                String       @id @default(cuid())
  userId            String
  categoryId        String
  period            BudgetPeriod @default(MONTHLY)
  amountCents       Int
  alertThresholdPct Int          @default(80) // alerta visual al superar este %
  rollover          Boolean      @default(false)
  startDate         DateTime     @db.Date
  endDate           DateTime?    @db.Date
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, categoryId])
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id             String             @id @default(cuid())
  userId         String
  name           String
  amountCents    Int
  interval       RecurrenceInterval @default(MONTHLY)
  nextChargeDate DateTime           @db.Date
  accountId      String // cuenta de pago (ASSET/LIABILITY)
  categoryId     String?
  isActive       Boolean            @default(true)
  autoPost       Boolean            @default(false) // generar transacción automáticamente
  url            String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions FinancialTransaction[]

  @@index([userId, nextChargeDate])
}

// =============================================================================
// 7. NUTRICIÓN (OpenFoodFacts España)
// =============================================================================

/// Caché compartida de productos de OpenFoodFacts (no pertenece a un usuario).
model FoodProduct {
  id             String   @id @default(cuid())
  barcode        String?  @unique
  name           String
  brand          String?
  imageUrl       String?
  servingSizeG   Float?
  kcalPer100g    Float?
  proteinPer100g Float?
  carbsPer100g   Float?
  sugarsPer100g  Float?
  fatPer100g     Float?
  satFatPer100g  Float?
  fiberPer100g   Float?
  saltPer100g    Float?
  nutriScore     String?  @db.Char(1)
  source         String   @default("openfoodfacts")
  raw            Json? // respuesta original para reprocesar
  fetchedAt      DateTime @default(now())

  entries       Macros[]
  templateItems MealTemplateItem[]

  @@index([name])
  @@index([brand])
}

enum MealType {
  BREAKFAST
  MID_MORNING
  LUNCH
  SNACK
  DINNER
  PRE_WORKOUT
  POST_WORKOUT
  OTHER
}

/// Registro diario de ingesta (una fila por alimento consumido).
/// Los macros se guardan como snapshot: si OpenFoodFacts cambia el producto,
/// el histórico no se altera.
model Macros {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  mealType      MealType
  foodProductId String?
  customName    String? // alimento manual sin producto
  quantityG     Float
  kcal          Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodProduct FoodProduct? @relation(fields: [foodProductId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model NutritionGoal {
  id                    String   @id @default(cuid())
  userId                String
  effectiveFrom         DateTime @db.Date
  kcal                  Int
  proteinG              Int
  carbsG                Int
  fatG                  Int
  fiberG                Int?
  // Ajuste según día de entrenamiento: multiplicador de kcal si hay sesión
  trainingDayKcalFactor Float    @default(1.0)
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
}

// =============================================================================
// 8. ASTRAS AI — RAG (pgvector), chat, flashcards y coach
// =============================================================================

enum DocumentStatus {
  PENDING
  PROCESSING
  EMBEDDED
  FAILED
}

model StudyDocument {
  id          String         @id @default(cuid())
  userId      String
  title       String
  subject     String? // asignatura
  mimeType    String
  storagePath String // ruta en volumen /uploads (no en BD)
  sizeBytes   Int
  status      DocumentStatus @default(PENDING)
  error       String?
  embedModel  String? // p.ej. "gemini-embedding-001@768"
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  flashcards Flashcard[]

  @@index([userId, subject])
}

/// Fragmento vectorizado. `embedding` se escribe/lee con SQL crudo
/// ($executeRaw / $queryRaw) porque Prisma no soporta el tipo vector.
/// Índice HNSW (vector_cosine_ops) creado en la migración inicial
/// a partir de prisma/sql/pgvector_setup.sql.
model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  userId     String // desnormalizado: filtrar por usuario antes del KNN
  chunkIndex Int
  content    String
  tokenCount Int?
  page       Int?
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  document StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId])
}

enum ChatKind {
  STUDY
  COACH
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  kind      ChatKind
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, kind])
}

model ChatMessage {
  id           String   @id @default(cuid())
  threadId     String
  role         ChatRole
  content      String
  citations    Json? // [{ chunkId, documentId, page, score }]
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model FlashcardDeck {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Flashcard[]

  @@unique([userId, name])
}

/// Repetición espaciada SM-2.
model Flashcard {
  id               String    @id @default(cuid())
  deckId           String
  sourceDocumentId String?
  front            String
  back             String
  easeFactor       Float     @default(2.5)
  intervalDays     Int       @default(0)
  repetitions      Int       @default(0)
  dueAt            DateTime  @default(now())
  lastReviewedAt   DateTime?
  createdAt        DateTime  @default(now())

  deck           FlashcardDeck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceDocument StudyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([deckId, dueAt])
}

/// Informe semanal del Coach de Rendimiento (Gemini).
model CoachReport {
  id              String   @id @default(cuid())
  userId          String
  weekStart       DateTime @db.Date // lunes de la semana analizada
  inputSnapshot   Json // carga (TSS por tipo), CTL/ATL/TSB, VFC, sueño...
  summary         String // markdown
  recommendations Json? // [{ area, action, rationale, priority }]
  model           String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// =============================================================================
// v1.2 — Uso diario: plantillas de sesión, comidas favoritas y lesiones
// =============================================================================

/// Plantilla de sesión ("Fuerza A", "Series 6×400"). `payload` es el cuerpo de
/// POST /api/training/sessions sin fecha, validado con createSessionSchema al usarla.
model SessionTemplate {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      SessionType
  payload   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// Comida favorita: un conjunto de alimentos con cantidades que se registra de una vez.
model MealTemplate {
  id        String    @id @default(cuid())
  userId    String
  name      String
  mealType  MealType?
  createdAt DateTime  @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealTemplateItem[]

  @@unique([userId, name])
}

model MealTemplateItem {
  id            String  @id @default(cuid())
  templateId    String
  foodProductId String?
  customName    String?
  quantityG     Float
  kcal          Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float?

  template    MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  foodProduct FoodProduct? @relation(fields: [foodProductId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

enum BodyArea {
  HEAD_NECK
  SHOULDER
  ELBOW
  WRIST_HAND
  CHEST
  UPPER_BACK
  LOWER_BACK
  ABDOMEN
  HIP_GROIN
  GLUTE
  HAMSTRING
  QUADRICEPS
  KNEE
  CALF
  ACHILLES
  ANKLE
  FOOT
  OTHER
}

enum BodySide {
  LEFT
  RIGHT
  BOTH
}

/// Mesociclo importado de un PDF «día a día» (Planificación → Importar).
/// Guarda la introducción, las semanas y las versiones elegibles; los días van en PlanDay.
model PlanMeso {
  id         String    @id @default(cuid())
  userId     String
  code       String // "M5"
  name       String
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  version    String? // versión del PDF («versión 12»)
  intro      Json // [{ title, text }]
  annexes    Json      @default("[]") // anexos del PDF: tabla de RM, cálculos, referencias…
  weeks      Json // [{ variant, number, title, start, end, text }]
  variants   Json // opciones elegibles [{ code, label }]; [] si el bloque no tiene versiones
  variant    String? // opción activa
  anchorDate DateTime? @db.Date // día de la competición para los días relativos (D−5…D)
  cycleId    String? // mesociclo en TrainingCycle
  source     String    @default("IMPORT") // IMPORT (PDF) | AI (generado con Gemini)
  status     String    @default("ACTIVE") // ACTIVE | DRAFT (generado, aún sin pasar a entrenamientos)
  meta       Json? // plan con IA: cuestionario (sin datos del ciclo), modelo y avisos de validación
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     PlanDay[]
  feedback PlanFeedback[]

  @@unique([userId, code])
}

/// Día del plan importado. Solo los de la versión activa se convierten en una
/// TrainingSession PLANNED (sessionId); los demás quedan aquí para consultarlos y
/// para cambiar de versión sin volver a subir el plan. sessionId no es FK a
/// propósito: editar una sesión la recrea con el mismo id.
model PlanDay {
  id          String      @id @default(cuid())
  userId      String
  mesoId      String
  key         String // meso|variante|fecha o D-n|orden (estable entre importaciones)
  variant     String?
  week        Int?
  code        String // «S1», «A·S2-V», «C·D−5»
  date        DateTime?   @db.Date
  relDay      Int?
  title       String
  durationMin Int?
  competition Boolean     @default(false)
  type        SessionType
  weekTitle   String?
  content     Json // bloques: texto, tablas de ejercicios y «Por qué»
  sessionId   String?
  eventId     String? // competición creada en el calendario
  light       Json? // versión suave del día { durationMin, blocks } (planes con IA)
  mode        String? // null = normal · LIGHT = usar la versión suave
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meso PlanMeso @relation(fields: [mesoId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, date])
  @@index([sessionId])
  @@index([mesoId])
}

/// Cómo fue una semana de un plan con IA: ajusta la carga de la siguiente.
model PlanFeedback {
  id        String   @id @default(cuid())
  userId    String
  mesoId    String
  week      Int
  rating    String // EASY | OK | HARD
  pain      Int? // 0-10
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meso PlanMeso @relation(fields: [mesoId], references: [id], onDelete: Cascade)

  @@unique([mesoId, week])
}

/// Ciclo menstrual (opcional). Dato de salud de categoría especial: `data` va
/// cifrado (AES-256-GCM), nunca se envía a la IA y el coach no lo ve.
model CycleProfile {
  userId    String   @id
  data      String // cifrado: { avgLength, periodDays, lastStart, hormonal, symptoms, symptomParts }
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CycleLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  data      String // cifrado: { period, symptoms }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Tabla de RM: una fila por valor con su fecha (el vigente es el último). Por nombre
/// normalizado para poder enlazar con los ejercicios del plan importado.
model OneRepMax {
  id            String   @id @default(cuid())
  userId        String
  name          String
  nameKey       String // nombre normalizado (minúsculas, sin tildes ni paréntesis)
  kg            Float
  perHand       Boolean  @default(false) // mancuernas: el valor es por mano
  source        String   @default("MANUAL") // MANUAL | PLAN (anexo del plan) | TEST (serie de test) | APRE
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nameKey, effectiveFrom])
}

/// Cómo se llama en el plan un ejercicio del catálogo o de la tabla de RM (se aprende al elegirlo).
model ExerciseAlias {
  id         String  @id @default(cuid())
  userId     String
  key        String // nombre del plan normalizado
  rmKey      String? // fila de la tabla de RM
  exerciseId String? // ejercicio del catálogo para registrar las series

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Enlace secreto de solo lectura al calendario (.ics). Se guarda el hash del token.
model CalendarFeed {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Informe de solo lectura para la entrenadora (enlace con caducidad). Se guarda el hash del token.
model SharedReport {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  from            DateTime @db.Date
  to              DateTime @db.Date
  includeInjuries Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Molestia o lesión. Dato de salud: no se envía a la IA; el coach solo la ve
/// con el permiso RECOVERY. Activa mientras resolvedOn sea null.
model Injury {
  id             String    @id @default(cuid())
  userId         String
  area           BodyArea
  side           BodySide?
  pain           Int // 0–10
  limitsTraining Boolean   @default(false)
  startedOn      DateTime  @db.Date
  resolvedOn     DateTime? @db.Date
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  protocol ReturnProtocol?

  @@index([userId, startedOn])
}

// =============================================================================
// v1.2 — Notificaciones push e importación de extractos
// =============================================================================

/// Suscripción Web Push de un navegador/dispositivo. Se borra sola si el
/// servicio de push responde 404/410 (el usuario la revocó o desinstaló la PWA).
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Notificaciones ya enviadas (clave lógica, p. ej. "digest:2026-10-06"): evita
/// repetirlas si el planificador se ejecuta varias veces o el contenedor se reinicia.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  key    String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Cómo leer el extracto de un banco (columnas, formato de fecha y de importe).
/// `mapping` sigue el esquema bankMappingSchema (src/lib/finance/bank-import.ts).
model BankImportProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  accountId String
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// =============================================================================
// v1.5
// =============================================================================

/// Salud de la mujer (opcional): embarazo/posparto, umbrales y avisos. Dato de
/// salud de categoría especial: `data` va cifrado, nunca a la IA ni al coach.
model WomenHealth {
  userId    String   @id
  data      String // cifrado: { mode, postpartumSince, ppPhase, cleared, eaMin, ferritinMin, labEveryMonths, remindPeriod }
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registros de salud cifrados (LEAF-Q, analíticas, suelo pélvico, descanso de la píldora,
/// controles posparto). Solo la fecha va en claro: el tipo también va cifrado.
model HealthLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  data      String // cifrado: { kind, ... }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Batería de tests físicos (30 m, salto horizontal, balón medicinal… o propios).
model TestResult {
  id             String   @id @default(cuid())
  userId         String
  testKey        String // clave del catálogo o «custom:<nombre normalizado>»
  name           String
  unit           String // s, m, cm, kg, reps…
  higherIsBetter Boolean
  value          Float
  date           DateTime @db.Date
  notes          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testKey, date])
}

/// Vuelta tras lesión por fases, con criterios para pasar de fase.
model ReturnProtocol {
  id        String   @id @default(cuid())
  userId    String
  injuryId  String   @unique
  phases    Json // [{ name, criteria: [{ text, done }], maxPain }]
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  injury Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)
}

/// Horario de clases (semanal) y exámenes (fecha concreta).
model ClassSlot {
  id        String    @id @default(cuid())
  userId    String
  subject   String
  kind      String // CLASS | EXAM
  weekday   Int? // 0 = lunes … 6 = domingo (clases)
  date      DateTime? @db.Date // exámenes
  startMin  Int // minutos desde las 00:00
  endMin    Int
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  location  String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bloque de estudio (pomodoro) terminado.
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  date      DateTime @db.Date
  minutes   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String   @id @default(cuid())
  userId  String
  habitId String
  date    DateTime @db.Date

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

/// Material (jabalinas, clavos…) con vida útil y aviso de reposición.
model Equipment {
  id               String    @id @default(cuid())
  userId           String
  name             String
  kind             String // JAVELIN | SPIKES | SHOES | OTHER
  implementWeightG Int? // jabalina: cuenta los lanzamientos con ese peso
  purchasedOn      DateTime? @db.Date
  lifeUses         Int? // sesiones (calzado) o lanzamientos (jabalina)
  lifeMonths       Int?
  extraUses        Int       @default(0) // usos anotados a mano
  transactionId    String? // gasto de compra (opcional)
  retired          Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Agua bebida (ml), varias anotaciones por día.
model HydrationLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Comentarios de la entrenadora (y respuestas del atleta) en una sesión.
/// `sessionId` sin clave foránea: editar una sesión la recrea con el mismo id.
model SessionComment {
  id        String   @id @default(cuid())
  sessionId String
  athleteId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  athlete User @relation("CommentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  author  User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
