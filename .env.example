# =============================================================================
# LifeOS — plantilla de variables de entorno. NO pongas valores reales aquí.
#   Desarrollo:  cp .env.example .env.local
#   Producción:  cp .env.example .env.production
# =============================================================================

# --- PostgreSQL (usado por docker-compose) ---
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeos
POSTGRES_PORT=5432

# --- Prisma ---
# Desarrollo (Next en el host, BD en Docker). En Docker, compose la sobrescribe.
DATABASE_URL=postgresql://lifeos:change-me@localhost:5432/lifeos?schema=public

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Web ---
WEB_PORT=3000
# 127.0.0.1 = solo accesible a través del proxy HTTPS del host (recomendado).
# 0.0.0.0 = expuesto en la red (Docker se salta ufw: protégelo con firewall externo).
WEB_BIND=127.0.0.1
# Auth.js: genera con `openssl rand -base64 32`
AUTH_SECRET=
# URL pública exacta con la que se accede (https://lifeos.tudominio.es en producción)
AUTH_URL=http://localhost:3000
# Registro de cuentas nuevas desde /register. false = cerrado (recomendado en un
# servidor expuesto); el primer usuario de una instalación vacía siempre puede
# registrarse. Para añadir más: npm run user -- create <email>
ALLOW_REGISTRATION=false
# Tareas programadas dentro del contenedor web: cobro diario de suscripciones e
# informe semanal del coach IA (solo usuarios con consentimiento de IA).
SCHEDULER_ENABLED=true
# Verificación en dos pasos (2FA): clave para cifrar los secretos TOTP en la BD.
# Genera con `openssl rand -base64 32`. Sin ella no se puede activar la 2FA.
# ¡No la pierdas! Si cambia, quien tenga 2FA activa no podrá entrar (npm run user -- disable-2fa).
TOTP_ENCRYPTION_KEY=
# (v1.4, opcional) Clave propia para datos de salud cifrados («Mi ciclo»). Sin ella se usa TOTP_ENCRYPTION_KEY.
# Si la pones, hazlo ANTES de usar «Mi ciclo»: con otra clave, lo ya guardado no se puede leer.
# DATA_ENCRYPTION_KEY=
# Driver de logs del contenedor web: journald en Debian (para fail2ban, manual § 6);
# json-file en Docker Desktop (Windows/macOS), donde journald no existe.
WEB_LOG_DRIVER=json-file

# --- Notificaciones push (opcional) ---
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para el servicio de push: mailto:tu@email o https://tu-dominio
VAPID_SUBJECT=

# --- Atlenza IA ---
# v1.9: cada usuario configura su propia IA en Ajustes → IA (Google, OpenAI y compatibles, Anthropic
# o un modelo local). GEMINI_API_KEY es opcional: si la pones, sirve de respaldo para quien no tenga la suya.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
# Modelos locales que se pueden elegir (Ollama, LM Studio…), separados por comas. Ej.: http://ollama:11434/v1
AI_LOCAL_BASE_URLS=

# --- OpenFoodFacts ---
OFF_BASE_URL=https://es.openfoodfacts.org
OFF_USER_AGENT="LifeOS/0.1 (tu-email@example.com)"

# --- Ficheros subidos (apuntes RAG) ---
UPLOAD_DIR=./uploads
# Espacio máximo de apuntes por usuario (MB)
UPLOAD_QUOTA_MB=200

# --- Copias de seguridad (servicio "backup", opcional; manual § 8) ---
# Clave PÚBLICA de age (age1…). La privada NUNCA en el servidor.
BACKUP_AGE_RECIPIENT=
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
